{
  "name": "pelaporan-api-gateway",
  "version": "1.0.0",
  "description": "Standalone API Gateway for Pelaporan Data on Hyperledger Fabric",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node pelaporan-api.js",
    "start:dev": "node --watch pelaporan-api.js",
    "start:port": "PORT=3200 node pelaporan-api.js",
    "test": "curl http://localhost:3100/api/health"
  },
  "engineStrict": true,
  "author": "Evaluasi RAFT HLF",
  "license": "Apache-2.0",
  "dependencies": {
    "@grpc/grpc-js": "^1.12.2",
    "@hyperledger/fabric-gateway": "^1.7.0",
    "express": "^4.18.2"
  },
  "keywords": [
    "hyperledger",
    "fabric",
    "blockchain",
    "api-gateway",
    "pelaporan",
    "raft"
  ]
}
